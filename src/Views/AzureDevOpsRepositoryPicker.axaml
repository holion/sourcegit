<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
                    x:Class="SourceGit.Views.AzureDevOpsRepositoryPicker"
                    x:DataType="vm:AzureDevOpsRepositoryPicker"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.AzureDevOps.Picker}"
                    Width="640" Height="520"
                    MinWidth="480" MinHeight="320"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.AzureDevOps}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.AzureDevOps.Picker}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="12,12,12,8" ColumnDefinitions="*,8,180,4,Auto">
      <TextBox Grid.Column="0"
               x:Name="FilterTextBox"
               Height="28"
               CornerRadius="14"
               BorderThickness="1"
               BorderBrush="{DynamicResource Brush.Border2}"
               VerticalContentAlignment="Center"
               Watermark="{DynamicResource Text.AzureDevOps.Picker.Search}"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <Path Width="14" Height="14"
                Margin="8,0,0,0"
                Fill="{DynamicResource Brush.FG2}"
                Data="{StaticResource Icons.Search}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <Button Classes="icon_button"
                  Width="16"
                  Margin="0,0,6,0"
                  Command="{Binding ClearFilter}"
                  IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  HorizontalAlignment="Right">
            <Path Width="14" Height="14"
                  Margin="0,1,0,0"
                  Fill="{DynamicResource Brush.FG1}"
                  Data="{StaticResource Icons.Clear}"/>
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>

      <ComboBox Grid.Column="2"
                Height="28"
                Padding="8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}"/>

      <Button Grid.Column="4"
              Classes="icon_button"
              Width="28" Height="28"
              Command="{Binding Refresh}"
              ToolTip.Tip="{DynamicResource Text.AzureDevOps.Picker.Refresh}">
        <Grid>
          <Path Width="14" Height="14"
                Data="{StaticResource Icons.Loading}"
                IsVisible="{Binding !Account.IsLoading}"/>
          <v:LoadingIcon Width="14" Height="14"
                         IsVisible="{Binding Account.IsLoading}"/>
        </Grid>
      </Button>
    </Grid>

    <!-- Repositories -->
    <Border Grid.Row="2"
            Margin="12,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}">
      <Grid>
        <ListBox x:Name="RepoListBox"
                 Background="Transparent"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding VisibleRepos}"
                 SelectedItem="{Binding SelectedRepo, Mode=TwoWay}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,4"/>
              <Setter Property="MinHeight" Value="0"/>
            </Style>
          </ListBox.Styles>

          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:AzureDevOpsRepository">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Background="Transparent" DoubleTapped="OnItemDoubleTapped">
                <Path Grid.Row="0" Grid.Column="0"
                      Width="12" Height="12"
                      Margin="0,0,8,0"
                      Fill="{DynamicResource Brush.FG2}"
                      Data="{StaticResource Icons.Lock}"
                      IsVisible="{Binding IsPrivate}"/>
                <Path Grid.Row="0" Grid.Column="0"
                      Width="12" Height="12"
                      Margin="0,0,8,0"
                      Fill="{DynamicResource Brush.FG2}"
                      Data="{StaticResource Icons.Repositories}"
                      IsVisible="{Binding !IsPrivate}"/>

                <TextBlock Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Project.Name, Mode=OneWay, StringFormat={}{0}/}" Foreground="{DynamicResource Brush.FG2}"/>
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                  <Border Margin="6,0,0,0" Padding="6,0" Height="16" CornerRadius="8"
                          Background="{DynamicResource Brush.Accent}"
                          IsVisible="{Binding IsCloned}">
                    <TextBlock FontSize="10" VerticalAlignment="Center" Foreground="White" Text="{DynamicResource Text.AzureDevOps.Picker.Cloned}"/>
                  </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.FG2}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Organization}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <v:LoadingIcon Width="24" Height="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding Account.IsLoading}"/>

        <TextBlock Margin="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="Red"
                   Text="{Binding Account.LoadError}"
                   IsVisible="{Binding Account.LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </Grid>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="12" ColumnDefinitions="*,Auto,Auto">
      <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
        <TextBlock FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.AzureDevOps.Picker.MissingOrganization}"/>
        <TextBlock FontSize="12"
                   Cursor="Hand"
                   HorizontalAlignment="Left"
                   Foreground="{DynamicResource Brush.Link}"
                   TextDecorations="Underline"
                   Text="{DynamicResource Text.AzureDevOps.Picker.OpenOrganizations}"
                   PointerPressed="OnOpenOrganizations"/>
      </StackPanel>

      <Button Grid.Column="1"
              Classes="flat primary"
              Height="30"
              Margin="8,0,0,0"
              Padding="16,0"
              Click="OnClone"
              Content="{DynamicResource Text.AzureDevOps.Picker.Clone}"
              IsEnabled="{Binding SelectedRepo, Converter={x:Static ObjectConverters.IsNotNull}}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>

      <Button Grid.Column="2"
              Classes="flat"
              Width="80"
              Height="30"
              Margin="4,0,0,0"
              HotKey="Escape"
              Click="OnCancel"
              Content="{DynamicResource Text.Cancel}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
