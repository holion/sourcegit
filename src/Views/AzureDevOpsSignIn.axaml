<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
                    x:Class="SourceGit.Views.AzureDevOpsSignIn"
                    x:DataType="vm:AzureDevOpsSignIn"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.AzureDevOps.SignIn}"
                    SizeToContent="WidthAndHeight"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.AzureDevOps}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.AzureDevOps.SignIn}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Body -->
    <StackPanel Grid.Row="1" Margin="24,20,24,8" Width="380" Orientation="Vertical">
      <Path Width="40" Height="40"
            HorizontalAlignment="Center"
            Fill="{DynamicResource Brush.FG1}"
            Data="{StaticResource Icons.AzureDevOps}"/>

      <TextBlock Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{DynamicResource Text.AzureDevOps.SignIn.Instructions}"/>

      <Border Margin="0,16,0,0"
              Height="56"
              CornerRadius="6"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}">
        <Grid ColumnDefinitions="*,Auto">
          <SelectableTextBlock Grid.Column="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               FontSize="26"
                               FontWeight="Bold"
                               Text="{Binding UserCode}"/>
          <v:LoadingIcon Grid.Column="0"
                         Width="18" Height="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding UserCode, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
          <Button Grid.Column="1"
                  Classes="icon_button"
                  Width="32" Height="32"
                  Margin="0,0,8,0"
                  Click="OnCopyCode"
                  ToolTip.Tip="{DynamicResource Text.Copy}"
                  IsVisible="{Binding UserCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Copy}"/>
          </Button>
        </Grid>
      </Border>

      <TextBlock Margin="0,8,0,0"
                 HorizontalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{DynamicResource Text.AzureDevOps.SignIn.CodeCopied}"
                 IsVisible="{Binding UserCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <StackPanel Margin="0,16,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsWaiting}">
        <v:LoadingIcon Width="14" Height="14"/>
        <TextBlock Margin="8,0,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.AzureDevOps.SignIn.Waiting}"/>
      </StackPanel>

      <TextBlock Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="Red"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="2" Margin="0,8,0,16" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Classes="flat primary"
              Height="30"
              Margin="4,0"
              Padding="12,0"
              Click="OnOpenVerificationPage"
              Content="{DynamicResource Text.AzureDevOps.SignIn.OpenBrowser}"
              IsVisible="{Binding IsWaiting}"
              IsEnabled="{Binding UserCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>

      <Button Classes="flat primary"
              Height="30"
              Margin="4,0"
              Padding="12,0"
              Click="OnRetry"
              Content="{DynamicResource Text.AzureDevOps.SignIn.Retry}"
              IsVisible="{Binding !IsWaiting}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>

      <Button Classes="flat"
              Width="80"
              Height="30"
              Margin="4,0"
              HotKey="Escape"
              Click="OnCancel"
              Content="{DynamicResource Text.Cancel}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
